# Start safely through an SSH tunnel. Change to https://your-domain for Nginx.
WEB_PUBLIC_URL=http://localhost:9080
WEB_BIND_IP=127.0.0.1
WEB_PUBLISHED_PORT=9080
# Plain TCP must remain in localhost/VPN/trusted LAN. Not public Internet TLS.
TCP_BIND_IP=127.0.0.1
TCP_PUBLISHED_PORT=9000
DATA_PATH=/docker_volume/AI-vision-tcp-server/data
AUTO_BACKUP=1
WEB_ALLOW_INSECURE_HTTP=0
PYTHON_IMAGE=python:3.13-slim-trixie
